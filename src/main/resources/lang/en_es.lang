# ═══════════════════════════════════════════
#  Welcome Plugin — English (en_us)
# ═══════════════════════════════════════════

# ═══════════════ MOTD ═══════════════
motd.lines.1=<dark_purple>| <gold>Hello, %player_name%!</gold></dark_purple>
motd.lines.2=<dark_purple>| <gray>Glad to see you back on the server!</gray>
motd.lines.3=<dark_purple>| <green>VK: %welcome_vk_url%</green>
motd.lines.4=<dark_purple>| <green>Website: %welcome_site_url%</green>
motd.lines.5=<dark_purple>| <green>Discord: %welcome_discord_url%</green>
motd.lines.6=<dark_purple>| <gray>Have a nice game!</gray>

# ═══════════════ TITLES ═══════════════
titles.first_join.title=<gold>Welcome!</gold>
titles.first_join.subtitle=<gray>%player_name%, you're new here! <yellow>#%number%</yellow></gray>
titles.join.title=<green>Welcome back!</green>
titles.join.subtitle=<gray>%player_name%</gray>
titles.death.title=<red>You died!</red>
titles.death.subtitle=<gray>But you'll be back...</gray>

# ═══════════════ ACTION BAR ═══════════════
actionbar.first_join=<gold>✨ Welcome to the server, %player_name%!</gold>
actionbar.join=<green>Welcome back, %player_name%!</green>

# ═══════════════ JOIN ═══════════════
join.first_join.1=<gold>🎉 Newcomer alert! Let's welcome <white>%player_name%</white> with applause! <gray>(#%number%)</gray></gold>
join.first_join.2=<green>✨ <white>%player_name%</white> just joined! <gray>(#%number%)</gray></green>
join.first_join.3=<aqua>Welcome, %player_name%! You're newcomer #%number%!</aqua>

join.default.1=<green>Welcome, %player_name%!</green>
join.default.2=<yellow>Hi, %player_name%!</yellow>
join.default.3=<aqua>Glad to see you, %player_name%!</aqua>

quit.default.1=<red>➖ <gray><white>%player_name%</white> left... probably to get some tea.</gray>
quit.default.2=<gray>%player_name% left the server.</gray>
quit.default.3=<yellow>See you, %player_name%!</yellow>

# ═══════════════ GROUPS ═══════════════

