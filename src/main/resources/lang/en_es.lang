groups.deluxe.quit.1=<aqua>💎 Deluxe <white>%player_name%</white> left on business.</aqua>
groups.deluxe.quit.2=<gray>Deluxe %player_name% left us.</gray>
groups.deluxe.quit.3=<aqua>💎 Bye, %player_name%!</aqua>

