groups.default.join.2=<blue>%player_name% joined us!</blue>
groups.default.join.3=<yellow>Welcome %player_name%!</yellow>
groups.default.quit.1=<red>➖ <gray><white>%player_name%</white> left... probably to get some tea.</gray>
groups.default.quit.2=<gray>%player_name% left the server.</gray>
groups.default.quit.3=<yellow>See you, %player_name%!</yellow>

