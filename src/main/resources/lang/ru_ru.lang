# ═══════════════ DEATH ═══════════════
death.pvp.1=<red>⚔ {killer} показал {victim}, кто тут босс!</red>
death.pvp.2=<gold>{killer}</gold> выписал <red>{victim}</red> пропуск в мир духов!
